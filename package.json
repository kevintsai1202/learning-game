{
  "name": "learning-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "知識島大冒險：給國小二年級的 3D 遊戲化學習網頁（國語、數學、英語、生活與健康）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4183 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "server:build": "vite build --config server/vite.config.ts",
    "server:start": "node server-dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "hanzi-writer": "^3.7.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
